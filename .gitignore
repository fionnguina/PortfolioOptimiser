# Ignore build artefacts and large binaries
*.exe
*.pkg
*.zip
*.pyc
build/
dist/
__pycache__/
Exports/
Portfolio_Report.pptx
Portfolio_Report_*.pptx

# Jupyter / PyInstaller / transient build state
.ipynb_checkpoints/
*.spec
build_log.txt
last_run_state.json

# Office lock files (~$Document.docx, ~$Workbook.xlsx, etc.)
~$*

# Auto-generated user artefacts (state, region overrides, output workbooks)
regions.json
Stock Analysis_AUTO.xlsm

# Stress-test outputs (Tier-1 #2)
gfc_stress_drawdown.png
gfc_stress_summary.json
gfc_run.log

# Scale-analysis outputs (one-shot diagnostic, regenerate via --scale-analysis)
scale_run.log

# Drift tracker logs (Tier-1 #3) — local-only state, append-only
trade_recommendation_log.jsonl
live_nav_history.jsonl
cash_ledger.jsonl
# Per-machine record of which scheduled jobs actually ran (ops_assertions.py).
# Local operational telemetry, not fund data — and tracking a file that grows
# on every run is what made the build's -dirty stamp meaningless.
run_ledger.jsonl

# Auto-generated by build_helper.py on each build
_version.py

# OOS disk cache (Phase 3a, 2026-06-29) — recomputable, never share
.cache/

# Generated PowerPoint reports — regenerated every run, large binaries
Reports/

# Reorganised outputs (2026-07-08) — regenerable run/experiment artefacts.
# All *.log now live in logs/; experiment summaries + diagnostic charts too.
# Keeps the working tree + git status clean as experiments regenerate them.
logs/
archive/
*.log
*_summary.json
dev_validation_chart.png
scale_analysis_chart.png
simulator_nav_chart.png

# Broker/live state — local-only, append-only, never share
ibkr_fills_log.jsonl
ibkr_nav_log.jsonl
simulator_fills.jsonl
simulator_nav.jsonl
simulator_sanity.jsonl
sanity_alerts.jsonl
metrics_history.jsonl
tlh_cooldown_state.json
engine_done.flag

# Manual backups (e.g. *.jsonl.bak made before hand-editing state files).
# *.bak-* also covers timestamped backups (lots_seed.json.bak-2026-07-17_121954),
# which plain *.bak misses because the suffix trails the extension.
*.bak
*.bak-*
deferred_orders.json
tax_settlements.json

# IBKR Flex Web Service (2026-08-18). The TOKEN is a bearer credential for the
# brokerage account — it must never reach a commit. The statement XML is
# refreshed on every scheduled run, so tracking it would churn the tree and
# make the build stamp's -dirty marker meaningless again; it is re-fetchable
# from IBKR at any time, and ibkr_activity_statement.csv remains the archival
# copy in git.
flex_config.json
ibkr_flex_statement.xml
ibkr_flex_statement.xml.bak
ibkr_flex_statement.xml.tmp
